    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(-1, 1, 20)\n",
    "\n",
    "def f(x):\n",
    "  return x**2\n",
    "\n",
    "def g(x):\n",
    "  return 2*x\n",
    "\n",
    "plt.plot(x,f(x))\n",
    "plt.plot(x,g(x))\n",
    "\n"
   ]
  }
